{
  "expo": {
    "name": "Hercules Gym",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hercules-logo-removebg-preview.png",
    "scheme": "herculesgym",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.herculesgym.mobile"
    },
    "android": {
      "package": "com.herculesgym.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/hercules-logo-removebg-preview.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": false,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/hercules-logo-removebg-preview.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/hercules-logo-removebg-preview.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6367884f-d4e3-4294-9e8b-15aad81071d1"
      }
    },
    "owner": "rounaks",
    "updates": {
      "url": "https://u.expo.dev/6367884f-d4e3-4294-9e8b-15aad81071d1"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
