# Multi-stage build for React/Vite Web App
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --legacy-peer-deps || npm install

# Build the frontend with the live Cloud Run backend URL
ARG VITE_BACKEND_URL=https://hercules-gym-api-847366288287.asia-southeast1.run.app
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL

COPY . .
RUN npm run build

# Production Nginx Stage
FROM nginx:alpine

# Copy custom nginx configuration for SPA routing & port 8080
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy build artifacts
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]