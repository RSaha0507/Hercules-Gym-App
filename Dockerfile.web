# Multi-stage build for React/Vite Web App
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --legacy-peer-deps || npm install

# Build frontend with backend URL
ARG VITE_BACKEND_URL=https://hercules-gym-api-847366288287.asia-southeast1.run.app
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL

COPY . .
RUN npm run build

# Production Stage: Lightweight Node static server with native PORT & SPA support
FROM node:20-alpine

WORKDIR /app

RUN npm install -g serve

COPY --from=build /app/dist /app/dist

ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "serve -s /app/dist -l tcp://0.0.0.0:${PORT:-8080}"]